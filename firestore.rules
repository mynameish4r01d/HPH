rules_version = '2';

// Firestore security rules for HPH Renewable.
// Paste into: Firebase console → Firestore Database → Rules → Publish.

service cloud.firestore {
  match /databases/{database}/documents {

    // "Schedule a Visit" requests from the website (HPH RENEWABLE/schedule-a-visit/).
    // Anyone may submit a well-formed request; only admins can read them and
    // move them through the quote pipeline, correct their details and
    // attachments, or delete them (HPH RENEWABLE/admin/). The encoder account
    // can do all of that except delete. The public can't change or delete
    // anything.
    // Stages: keep in step with TABS.visits.pipeline in HPH RENEWABLE/admin/admin.js.
    match /visitRequests/{requestId} {
      allow create: if isValidVisitRequest(request.resource.data)
        || (isStaff() && isValidCopiedVisit(request.resource.data))
        || (isAdmin() && isValidOpenSolarVisit(requestId, request.resource.data));
      allow read: if isStaff();
      allow update: if (isAdmin() && (isValidStatusChange() || isValidOpenSolarSync()))
        || (isStaff()
            && (isValidStageChange(['new', 'contacted', 'scheduled', 'visited', 'quoted', 'installing', 'installed'])
                || isValidVisitEdit()));
      allow delete: if isAdmin();
    }

    // "Share Your Experience" feedback from the website (HPH RENEWABLE/feedback/).
    // Same idea: anyone may submit well-formed feedback; only admins can
    // read or delete it; nobody can change it (it's the customer's words).
    match /feedback/{feedbackId} {
      allow create: if isValidFeedback(request.resource.data);
      allow read, delete: if isAdmin();
      allow update: if false;
    }

    // "Join the Waitlist" sign-ups from the product pages (HPH RENEWABLE/join-waitlist/).
    // Anyone may sign up; only admins can read them, move them through the
    // waitlist pipeline (same stage fields as visit requests), correct their
    // contact details, or delete them. The encoder account can do all of
    // that except delete.
    // Stages: keep in step with TABS.waitlist.pipeline in HPH RENEWABLE/admin/admin.js.
    match /waitlist/{signupId} {
      allow create: if isValidWaitlist(request.resource.data);
      allow read: if isStaff();
      allow update: if (isAdmin() && isValidStatusChange())
        || (isStaff()
            && (isValidStageChange(['new', 'contacted', 'reserved', 'delivered', 'cancelled'])
                || isValidWaitlistEdit()));
      allow delete: if isAdmin();
    }

    // Installations (HPH RENEWABLE/admin/, "Installs" tab), which replaced the
    // installation Google Sheet. One document per install with the client's
    // details, its serial numbers and its panel count (panels whose serial
    // wasn't recorded still count). Admins and the encoder account can read,
    // add and edit any install. Admins can delete any install, and the
    // encoder only the ones it added. Imports from the sheet (source "sheet")
    // are admin-only.
    match /installs/{installId} {
      allow read: if isStaff();
      allow create: if isStaff()
        && isValidInstall(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.createdBy == request.auth.token.email
        && request.resource.data.updatedAt == null
        && request.resource.data.updatedBy == null
        && (request.resource.data.source == 'admin' || isAdmin());
      allow update: if isStaff()
        && isValidInstall(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.source == resource.data.source
        && request.resource.data.sheetTimestamp == resource.data.sheetTimestamp
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.token.email;
      allow delete: if isAdmin()
        || (isEncoder() && resource.data.createdBy == request.auth.token.email);
    }

    // Public totals per install: { inverters, panels }, no client details.
    // The public portfolio counters (HPH RENEWABLE/portfolio-counters.js) add
    // these up. Written in the same batch as the install and must match it
    // (MX2250 serials listed, panelCount); removed with it.
    match /installCounts/{installId} {
      allow read: if true;
      allow create, update: if isStaff()
        && request.resource.data.keys().hasOnly(['inverters', 'panels'])
        && request.resource.data.keys().hasAll(['inverters', 'panels'])
        && existsAfter(/databases/$(database)/documents/installs/$(installId))
        && request.resource.data.inverters
             == getAfter(/databases/$(database)/documents/installs/$(installId)).data.inverterSerials.size()
        && request.resource.data.panels
             == getAfter(/databases/$(database)/documents/installs/$(installId)).data.panelCount;
      allow delete: if isStaff()
        && !existsAfter(/databases/$(database)/documents/installs/$(installId));
    }

    // One document per recorded MX2250 / solar panel serial, its ID being the
    // serial itself, so a serial can't be recorded on two installs. Holds
    // only { type, installId }. Written in the same batch as the install that
    // lists the serial, and removed with it; never changed.
    match /serials/{serial} {
      allow read: if isStaff();
      allow create: if isStaff() && isValidSerial(serial, request.resource.data);
      allow update: if false;
      // The encoder may remove a serial its edit took off an install (the
      // install no longer lists it), or the serials of an install of its own
      // that it's deleting.
      allow delete: if isAdmin()
        || (isEncoder()
            && ((existsAfter(/databases/$(database)/documents/installs/$(resource.data.installId))
                 && !(serial in getAfter(/databases/$(database)/documents/installs/$(resource.data.installId)).data.inverterSerials)
                 && !(serial in getAfter(/databases/$(database)/documents/installs/$(resource.data.installId)).data.panelSerials))
                || (exists(/databases/$(database)/documents/installs/$(resource.data.installId))
                    && get(/databases/$(database)/documents/installs/$(resource.data.installId)).data.createdBy
                         == request.auth.token.email)));
    }

    // Admin page sign-in (Firebase Authentication, email + password).
    // Keep this list in step with ADMIN_EMAILS in HPH RENEWABLE/admin/admin.js
    // and isAdmin() in /storage.rules.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in ['harold.t.hermosa@gmail.com',
                                     'jeff.hermosa@hphtechsolutions.com',
                                     'lerin.hermosa@hphtechsolutions.com'];
    }

    // The encoder account: signs in on the admin page without the overview
    // dashboard or feedback. It adds and edits installations (deleting only
    // its own), and
    // views, edits and moves visit requests and waitlist sign-ups through the
    // pipeline, but can't delete them. Keep in step with ENCODER_EMAILS in
    // HPH RENEWABLE/admin/admin.js and isEncoder() in /storage.rules.
    function isEncoder() {
      return request.auth != null
        && request.auth.token.email in ['inquiries@hphtechsolutions.com'];
    }

    function isStaff() {
      return isAdmin() || isEncoder();
    }

    function isValidInstall(data) {
      let fields = ['clientName', 'email', 'contact', 'address', 'installDate', 'capacityKwp',
                    'inverterSerials', 'panelSerials', 'panelCount', 'batterySerials', 'source',
                    'sheetTimestamp', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'];
      return data.keys().hasOnly(fields)
        && data.keys().hasAll(fields)
        && isText(data.clientName, 1, 150)
        && isText(data.email, 0, 200)
        && isText(data.contact, 0, 100)
        && isText(data.address, 0, 300)
        // "YYYY-MM-DD", or empty.
        && isText(data.installDate, 0, 10)
        && (data.capacityKwp == null
            || (data.capacityKwp is number && data.capacityKwp >= 0 && data.capacityKwp <= 100000))
        && data.inverterSerials is list && data.inverterSerials.size() <= 100
        && data.panelSerials is list && data.panelSerials.size() <= 400
        // Panels installed, including any whose serial wasn't recorded.
        && data.panelCount is int
        && data.panelCount >= data.panelSerials.size() && data.panelCount <= 2000
        && data.batterySerials is list && data.batterySerials.size() <= 50
        && data.source in ['admin', 'sheet']
        && isText(data.sheetTimestamp, 0, 40)
        && data.createdBy is string;
    }

    // A serial's document: the ID must be a well-formed serial of its type
    // (not an all-zero placeholder), and the install it points to must list
    // it once this write is done.
    function isValidSerial(serial, data) {
      let install = getAfter(/databases/$(database)/documents/installs/$(data.installId));
      return data.keys().hasOnly(['type', 'installId'])
        && data.keys().hasAll(['type', 'installId'])
        && data.installId is string
        && ((data.type == 'inverter'
               && serial.matches('^Y[0-9A-Z]{15}$')
               && !serial.matches('^Y0+$')
               && serial in install.data.inverterSerials)
            || (data.type == 'panel'
               && serial.matches('^Z[0-9A-Z]{18}$')
               && !serial.matches('^Z0+$')
               && serial in install.data.panelSerials));
    }

    // Admin pipeline stage change: only stage, stageUpdatedAt and stageUpdatedBy
    // may change; the stage must be one of `stages`, stamped now, by this admin.
    function isValidStageChange(stages) {
      let data = request.resource.data;
      return data.diff(resource.data).affectedKeys()
               .hasOnly(['stage', 'stageUpdatedAt', 'stageUpdatedBy'])
        && data.stage in stages
        && data.stageUpdatedAt == request.time
        && data.stageUpdatedBy == request.auth.token.email;
    }

    // Admin "Edit details" on a visit request: only the client's answers and
    // the attachment list may change (same limits as the public form, but up
    // to 10 files, since admins can add bills for the client), stamped with
    // who edited it and when.
    function isValidVisitEdit() {
      let data = request.resource.data;
      return data.diff(resource.data).affectedKeys()
               .hasOnly(['name', 'phone', 'email', 'address', 'propertyType', 'product',
                         'monthlyBill', 'preferredDate', 'preferredTime', 'referralCode',
                         'message', 'attachments', 'editedAt', 'editedBy'])
        && isText(data.name, 1, 100)
        && isText(data.phone, 7, 30)
        && isText(data.email, 0, 200)
        && isText(data.address, 3, 300)
        && data.propertyType in ['Residential', 'Commercial', 'Industrial']
        && isText(data.product, 1, 50)
        && isText(data.monthlyBill, 0, 50)
        && isText(data.preferredDate, 0, 10)
        && isText(data.preferredTime, 1, 50)
        && isText(data.message, 0, 2000)
        && (!('referralCode' in data) || isText(data.referralCode, 0, 50))
        && data.attachments is list
        && data.attachments.size() <= 10
        && data.editedAt == request.time
        && data.editedBy == request.auth.token.email;
    }

    // An install's Ocular Visits entry, created automatically by the admin page
    // (staff): with a new install (at Quote sent), or for installs that had
    // none yet (at Installed). Its ID is "install-<installId>", so it's only
    // ever created once. Contact details may be blank (installs don't always
    // have them), there are no attachments, it's dated by the install date,
    // and it points back to its install (installId).
    function isValidCopiedVisit(data) {
      let fields = ['name', 'phone', 'email', 'address', 'propertyType', 'product',
                    'monthlyBill', 'preferredDate', 'preferredTime', 'message',
                    'attachments', 'consent', 'sourcePage', 'status', 'createdAt',
                    'stage', 'stageUpdatedAt', 'stageUpdatedBy', 'installId', 'source'];
      return data.keys().hasOnly(fields)
        && data.keys().hasAll(fields)
        && isText(data.name, 1, 100)
        && isText(data.phone, 0, 30)
        && isText(data.email, 0, 200)
        && isText(data.address, 0, 300)
        && data.propertyType in ['Residential', 'Commercial', 'Industrial']
        && isText(data.product, 1, 50)
        && isText(data.monthlyBill, 0, 50)
        && isText(data.preferredDate, 0, 10)
        && isText(data.preferredTime, 1, 50)
        && isText(data.message, 0, 2000)
        && data.attachments is list
        && data.attachments.size() == 0
        && data.consent is bool
        && isText(data.sourcePage, 0, 300)
        && data.status == 'new'
        && data.createdAt is timestamp
        && data.stage in ['new', 'contacted', 'scheduled', 'visited', 'quoted', 'installing', 'installed']
        && data.stageUpdatedAt == request.time
        && data.stageUpdatedBy == request.auth.token.email
        && isText(data.installId, 1, 100)
        && data.source == 'install';
    }

    // Admin "Import from OpenSolar" (an OpenSolar project export, CSV): a new
    // visit request for OpenSolar projects not on the dashboard yet. Its ID
    // is "opensolar-<first project id>", so the same project can't be added
    // twice, and openSolarIds lists all the client's OpenSolar projects
    // (alternative designs are grouped into one entry). openSolarLast keeps
    // what OpenSolar said for the name and contact details, so a later import
    // can tell a real change in OpenSolar from an old value.
    function isValidOpenSolarVisit(requestId, data) {
      let fields = ['name', 'phone', 'email', 'address', 'propertyType', 'product',
                    'monthlyBill', 'preferredDate', 'preferredTime', 'message',
                    'attachments', 'consent', 'sourcePage', 'status', 'createdAt',
                    'stage', 'stageUpdatedAt', 'stageUpdatedBy', 'source',
                    'openSolarIds', 'openSolarStage', 'openSolarSyncedAt', 'openSolarLast'];
      return data.keys().hasOnly(fields)
        && data.keys().hasAll(fields)
        && isText(data.name, 1, 100)
        && isText(data.phone, 0, 30)
        && isText(data.email, 0, 200)
        && isText(data.address, 0, 300)
        && data.propertyType in ['Residential', 'Commercial', 'Industrial']
        && isText(data.product, 1, 50)
        && isText(data.monthlyBill, 0, 50)
        && isText(data.preferredDate, 0, 10)
        && isText(data.preferredTime, 1, 50)
        && isText(data.message, 0, 2000)
        && data.attachments is list
        && data.attachments.size() == 0
        && data.consent is bool
        && isText(data.sourcePage, 0, 300)
        && data.status == 'new'
        && data.createdAt == request.time
        && data.stage in ['new', 'contacted', 'scheduled', 'visited', 'quoted', 'installing', 'installed']
        && data.stageUpdatedAt == request.time
        && data.stageUpdatedBy == request.auth.token.email
        && data.source == 'opensolar'
        && data.openSolarIds is list
        && data.openSolarIds.size() >= 1 && data.openSolarIds.size() <= 50
        && requestId == 'opensolar-' + data.openSolarIds[0]
        && isText(data.openSolarStage, 0, 30)
        && data.openSolarSyncedAt == request.time
        && isOpenSolarLast(data.openSolarLast);
    }

    // What OpenSolar last said: { name, phone, email, address }, all text.
    function isOpenSolarLast(last) {
      return last is map
        && last.keys().hasOnly(['name', 'phone', 'email', 'address'])
        && isText(last.get('name', ''), 0, 100)
        && isText(last.get('phone', ''), 0, 30)
        && isText(last.get('email', ''), 0, 200)
        && isText(last.get('address', ''), 0, 300);
    }

    // A later OpenSolar import on an existing visit request: links more
    // OpenSolar projects, records OpenSolar's stage and details, moves our
    // stage (the page only ever moves it forward), and updates the name,
    // phone, email or address (the page does so only when OpenSolar's value
    // changed since the last import, or ours is empty).
    function isValidOpenSolarSync() {
      let data = request.resource.data;
      return data.diff(resource.data).affectedKeys()
               .hasOnly(['openSolarIds', 'openSolarStage', 'openSolarSyncedAt', 'openSolarLast',
                         'stage', 'stageUpdatedAt', 'stageUpdatedBy',
                         'name', 'phone', 'email', 'address'])
        && data.openSolarIds is list
        && data.openSolarIds.size() >= 1 && data.openSolarIds.size() <= 50
        && isText(data.openSolarStage, 0, 30)
        && data.openSolarSyncedAt == request.time
        && (data.get('stage', '') == resource.data.get('stage', '')
            || (data.stage in ['new', 'contacted', 'scheduled', 'visited', 'quoted', 'installing', 'installed']
                && data.stageUpdatedAt == request.time
                && data.stageUpdatedBy == request.auth.token.email))
        && isOpenSolarLast(data.openSolarLast)
        && isText(data.name, 1, 100)
        && isText(data.phone, 0, 30)
        && isText(data.email, 0, 200)
        && isText(data.address, 0, 300);
    }

    // Admin "Edit details" on a waitlist sign-up: contact details and the
    // note only (the order and estimate stay as the visitor submitted them).
    function isValidWaitlistEdit() {
      let data = request.resource.data;
      return data.diff(resource.data).affectedKeys()
               .hasOnly(['name', 'phone', 'email', 'address', 'message', 'editedAt', 'editedBy'])
        && isText(data.name, 1, 100)
        && isText(data.phone, 7, 30)
        && isText(data.email, 0, 200)
        && isText(data.address, 5, 300)
        && isText(data.message, 0, 2000)
        && data.editedAt == request.time
        && data.editedBy == request.auth.token.email;
    }

    // Older admin "Mark as done" / "Mark as contacted" (and undo), from before
    // pipeline stages; kept so an admin page left open on the old version still
    // works. Only status, completedAt and completedBy may change, and they must
    // agree with each other.
    function isValidStatusChange() {
      let data = request.resource.data;
      return data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'completedAt', 'completedBy'])
        && ((data.status == 'done'
               && data.completedAt == request.time
               && data.completedBy == request.auth.token.email)
            || (data.status == 'new'
               && data.completedAt == null
               && data.completedBy == null));
    }

    function isText(value, minSize, maxSize) {
      return value is string && value.size() >= minSize && value.size() <= maxSize;
    }

    function isValidVisitRequest(data) {
      let fields = ['name', 'phone', 'email', 'address', 'propertyType', 'product',
                    'monthlyBill', 'preferredDate', 'preferredTime', 'message',
                    'attachments', 'consent', 'sourcePage', 'status', 'createdAt'];
      // referralCode is optional so requests from a cached older form still go through.
      return data.keys().hasOnly(fields.concat(['referralCode']))
        && data.keys().hasAll(fields)
        && (!('referralCode' in data) || isText(data.referralCode, 0, 50))
        && isText(data.name, 1, 100)
        && isText(data.phone, 7, 30)
        && isText(data.email, 0, 200)
        && isText(data.address, 3, 300)
        && data.propertyType in ['Residential', 'Commercial', 'Industrial']
        && isText(data.product, 1, 50)
        && isText(data.monthlyBill, 0, 50)
        && isText(data.preferredDate, 0, 10)
        && isText(data.preferredTime, 1, 50)
        && isText(data.message, 0, 2000)
        // Cloud Storage paths of uploaded files (see /storage.rules), max 3.
        && data.attachments is list
        && data.attachments.size() <= 3
        && data.consent == true
        && isText(data.sourcePage, 0, 300)
        && data.status == 'new'
        && data.createdAt == request.time;
    }

    // Waitlist quantities: unit 1-10 if present; battery 1-4 per unit (4 when
    // no unit is ordered, e.g. an existing owner adding batteries).
    function isQuantity(q, unit, battery) {
      let units = q.get(unit, 0);
      let batteries = q.get(battery, 0);
      return (!(unit in q) || (units is int && units >= 1 && units <= 10))
        && (!(battery in q) || (batteries is int && batteries >= 1
               && (batteries <= 4 || batteries <= 4 * units)));
    }

    function isValidWaitlist(data) {
      let fields = ['system', 'quantities', 'estimatedTotal', 'name', 'phone', 'email',
                    'address', 'message', 'consent', 'sourcePage', 'status', 'createdAt'];
      return data.keys().hasOnly(fields)
        && data.keys().hasAll(fields)
        // One system, and how many of its unit and/or its own battery, e.g.
        // { 'MAU5000 Elite': 1, 'B5000 Elite': 2 }. Zero quantities are left out.
        // Limits match waitlist-form.js: up to 10 units, 4 batteries per unit.
        && data.quantities is map
        && data.quantities.size() >= 1
        && ((data.system == 'MSU4000 Elite'
               && data.quantities.keys().hasOnly(['MSU4000 Elite', 'B4000 Elite'])
               && isQuantity(data.quantities, 'MSU4000 Elite', 'B4000 Elite'))
            || (data.system == 'MAU5000 Elite'
               && data.quantities.keys().hasOnly(['MAU5000 Elite', 'B5000 Elite'])
               && isQuantity(data.quantities, 'MAU5000 Elite', 'B5000 Elite')))
        && isText(data.name, 1, 100)
        && isText(data.phone, 7, 30)
        && isText(data.email, 0, 200)
        // Home / delivery address.
        && isText(data.address, 5, 300)
        // Estimate shown to the visitor from starting prices (pesos); not a quote.
        && data.estimatedTotal is int
        && data.estimatedTotal >= 0 && data.estimatedTotal <= 100000000
        && isText(data.message, 0, 2000)
        && data.consent == true
        && isText(data.sourcePage, 0, 300)
        && data.status == 'new'
        && data.createdAt == request.time;
    }

    function isValidFeedback(data) {
      let fields = ['rating', 'message', 'name', 'contact', 'allowPublish',
                    'sourcePage', 'status', 'createdAt'];
      return data.keys().hasOnly(fields)
        && data.keys().hasAll(fields)
        && data.rating is int
        && data.rating >= 1 && data.rating <= 5
        && isText(data.message, 1, 2000)
        && isText(data.name, 0, 100)
        && isText(data.contact, 0, 200)
        && data.allowPublish is bool
        && isText(data.sourcePage, 0, 300)
        && data.status == 'new'
        && data.createdAt == request.time;
    }
  }
}
