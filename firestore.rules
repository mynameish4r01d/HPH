rules_version = '2';

// Firestore security rules for HPH Renewable.
// Paste into: Firebase console → Firestore Database → Rules → Publish.

service cloud.firestore {
  match /databases/{database}/documents {

    // "Schedule a Visit" requests from the website (HPH RENEWABLE/schedule-a-visit/).
    // Anyone may submit a well-formed request; only admins can read them and
    // mark them done / not done (HPH RENEWABLE/admin/). Nobody can change
    // anything else or delete them from the website.
    match /visitRequests/{requestId} {
      allow create: if isValidVisitRequest(request.resource.data);
      allow read: if isAdmin();
      allow update: if isAdmin() && isValidStatusChange();
      allow delete: if false;
    }

    // "Share Your Experience" feedback from the website (HPH RENEWABLE/feedback/).
    // Same idea: anyone may submit well-formed feedback; only admins can
    // read it; nobody can change or delete it from the website.
    match /feedback/{feedbackId} {
      allow create: if isValidFeedback(request.resource.data);
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // "Join the Waitlist" sign-ups from the product pages (HPH RENEWABLE/join-waitlist/).
    // Anyone may sign up; only admins can read them and mark them contacted /
    // not contacted (same status fields as visit requests).
    match /waitlist/{signupId} {
      allow create: if isValidWaitlist(request.resource.data);
      allow read: if isAdmin();
      allow update: if isAdmin() && isValidStatusChange();
      allow delete: if false;
    }

    // Admin page sign-in (Firebase Authentication, email + password).
    // Keep this list in step with ADMIN_EMAILS in HPH RENEWABLE/admin/admin.js
    // and isAdmin() in /storage.rules.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in ['harold.t.hermosa@gmail.com'];
    }

    // Admin "Mark as done" / "Mark as contacted" (and undo): only status, completedAt and
    // completedBy may change, and they must agree with each other.
    function isValidStatusChange() {
      let data = request.resource.data;
      return data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'completedAt', 'completedBy'])
        && ((data.status == 'done'
               && data.completedAt == request.time
               && data.completedBy == request.auth.token.email)
            || (data.status == 'new'
               && data.completedAt == null
               && data.completedBy == null));
    }

    function isText(value, minSize, maxSize) {
      return value is string && value.size() >= minSize && value.size() <= maxSize;
    }

    function isValidVisitRequest(data) {
      let fields = ['name', 'phone', 'email', 'address', 'propertyType', 'product',
                    'monthlyBill', 'preferredDate', 'preferredTime', 'message',
                    'attachments', 'consent', 'sourcePage', 'status', 'createdAt'];
      return data.keys().hasOnly(fields)
        && data.keys().hasAll(fields)
        && isText(data.name, 1, 100)
        && isText(data.phone, 7, 30)
        && isText(data.email, 0, 200)
        && isText(data.address, 3, 300)
        && data.propertyType in ['Residential', 'Commercial', 'Industrial']
        && isText(data.product, 1, 50)
        && isText(data.monthlyBill, 0, 50)
        && isText(data.preferredDate, 0, 10)
        && isText(data.preferredTime, 1, 50)
        && isText(data.message, 0, 2000)
        // Cloud Storage paths of uploaded files (see /storage.rules), max 3.
        && data.attachments is list
        && data.attachments.size() <= 3
        && data.consent == true
        && isText(data.sourcePage, 0, 300)
        && data.status == 'new'
        && data.createdAt == request.time;
    }

    // Waitlist quantities: unit 1-10 if present; battery 1-4 per unit (4 when
    // no unit is ordered, e.g. an existing owner adding batteries).
    function isQuantity(q, unit, battery) {
      let units = q.get(unit, 0);
      let batteries = q.get(battery, 0);
      return (!(unit in q) || (units is int && units >= 1 && units <= 10))
        && (!(battery in q) || (batteries is int && batteries >= 1
               && (batteries <= 4 || batteries <= 4 * units)));
    }

    function isValidWaitlist(data) {
      let fields = ['system', 'quantities', 'name', 'phone', 'email', 'location', 'message',
                    'consent', 'sourcePage', 'status', 'createdAt'];
      return data.keys().hasOnly(fields)
        && data.keys().hasAll(fields)
        // One system, and how many of its unit and/or its own battery, e.g.
        // { 'MAU5000 Elite': 1, 'B5000 Elite': 2 }. Zero quantities are left out.
        // Limits match waitlist-form.js: up to 10 units, 4 batteries per unit.
        && data.quantities is map
        && data.quantities.size() >= 1
        && ((data.system == 'MSU4000 Elite'
               && data.quantities.keys().hasOnly(['MSU4000 Elite', 'B4000 Elite'])
               && isQuantity(data.quantities, 'MSU4000 Elite', 'B4000 Elite'))
            || (data.system == 'MAU5000 Elite'
               && data.quantities.keys().hasOnly(['MAU5000 Elite', 'B5000 Elite'])
               && isQuantity(data.quantities, 'MAU5000 Elite', 'B5000 Elite')))
        && isText(data.name, 1, 100)
        && isText(data.phone, 7, 30)
        && isText(data.email, 0, 200)
        && isText(data.location, 0, 100)
        && isText(data.message, 0, 2000)
        && data.consent == true
        && isText(data.sourcePage, 0, 300)
        && data.status == 'new'
        && data.createdAt == request.time;
    }

    function isValidFeedback(data) {
      let fields = ['rating', 'message', 'name', 'contact', 'allowPublish',
                    'sourcePage', 'status', 'createdAt'];
      return data.keys().hasOnly(fields)
        && data.keys().hasAll(fields)
        && data.rating is int
        && data.rating >= 1 && data.rating <= 5
        && isText(data.message, 1, 2000)
        && isText(data.name, 0, 100)
        && isText(data.contact, 0, 200)
        && data.allowPublish is bool
        && isText(data.sourcePage, 0, 300)
        && data.status == 'new'
        && data.createdAt == request.time;
    }
  }
}
