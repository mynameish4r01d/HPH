rules_version = '2';

// Cloud Storage security rules for HPH Renewable.
// Paste into: Firebase console → Storage → Rules → Publish.

service firebase.storage {
  match /b/{bucket}/o {

    // Who may do what is the same as in /firestore.rules: owners (the Main
    // admins) everything; everyone else by their level per page in Firestore
    // staffRoles/{email} (set in the admin page's Accounts section): view 1,
    // edit 2, delete 3 (edit + delete).

    // Files attached to "Schedule a Visit" requests (HPH RENEWABLE/schedule-a-visit/).
    // Anyone may upload a new image or PDF of up to 10 MB into a request's
    // folder (staff too, when adding a bill for a client). Ocular Visits users
    // view them (and so do checklist editors, for the Site Visit checklist's
    // "Import from Ocular Visit"); Edit removes them while editing a request,
    // and its files go with a deleted request. Nobody can replace a file.
    match /visitRequests/{requestId}/{fileName} {
      allow create: if resource == null
                    && request.resource.size <= 10 * 1024 * 1024
                    && (request.resource.contentType.matches('image/.*')
                        || request.resource.contentType == 'application/pdf');
      allow get: if can('visits', 1) || can('inspection', 2) || can('installation', 2);
      allow delete: if can('visits', 2);
      allow list, update: if false;
    }

    // Electricity bills attached to "Join the Waitlist" sign-ups
    // (HPH RENEWABLE/join-waitlist/, waitlist/<sign-up id>/). Same as visit
    // requests: anyone may upload a new image or PDF of up to 10 MB (staff
    // too, when adding a bill on the admin page). Waitlist users view them;
    // Edit removes them while editing a sign-up, and its files go with a
    // deleted sign-up. Nobody can replace a file.
    match /waitlist/{signupId}/{fileName} {
      allow create: if resource == null
                    && request.resource.size <= 10 * 1024 * 1024
                    && (request.resource.contentType.matches('image/.*')
                        || request.resource.contentType == 'application/pdf');
      allow get: if can('waitlist', 1);
      allow delete: if can('waitlist', 2);
      allow list, update: if false;
    }

    // Photos on installer checklist items (jobChecklists/<checklist id>/).
    // Checklist editors add an image of up to 10 MB and remove them; anyone
    // who can see a checklist page views them. Nobody can replace a file.
    match /jobChecklists/{checklistId}/{fileName} {
      allow create: if (can('inspection', 2) || can('installation', 2))
                    && resource == null
                    && request.resource.size <= 10 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*');
      allow get: if can('inspection', 1) || can('installation', 1);
      allow delete: if can('inspection', 2) || can('installation', 2);
      allow list, update: if false;
    }

    // Photos of inventory items (inventory/<item id>/). Inventory editors add
    // an image of up to 10 MB and remove them; viewers see them. Nobody can
    // replace a file.
    match /inventory/{itemId}/{fileName} {
      allow create: if can('inventory', 2)
                    && resource == null
                    && request.resource.size <= 10 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*');
      allow get: if can('inventory', 1);
      allow delete: if can('inventory', 2);
      allow list, update: if false;
    }

    function signedInWithEmail() {
      return request.auth != null && request.auth.token.get('email', null) is string;
    }

    // The Main admins. Keep in step with OWNER_EMAILS in
    // HPH RENEWABLE/admin/admin.js and isOwner() in /firestore.rules.
    function isOwner() {
      return signedInWithEmail()
        && request.auth.token.email in ['harold.t.hermosa@gmail.com',
                                     'jeff.hermosa@hphtechsolutions.com',
                                     'lerin.hermosa@hphtechsolutions.com'];
    }

    // The original accounts' access until they get a staffRoles entry.
    function legacyLevel(page) {
      return request.auth.token.email == 'inquiries@hphtechsolutions.com'
          ? {'visits': 2, 'waitlist': 2, 'installs': 2, 'inventory': 2, 'wishlist': 2}.get(page, 0)
        : request.auth.token.email == 'hphrenewable@gmail.com'
          ? {'inspection': 2, 'installation': 2, 'inventory': 2}.get(page, 0)
        : 0;
    }

    function accessLevel(page) {
      let path = /databases/(default)/documents/staffRoles/$(request.auth.token.email.lower());
      return firestore.exists(path)
        ? {'view': 1, 'edit': 2, 'delete': 3}.get(firestore.get(path).data.get('access', {}).get(page, 'off'), 0)
        : legacyLevel(page);
    }

    function can(page, level) {
      return isOwner() || (signedInWithEmail() && accessLevel(page) >= level);
    }
  }
}
