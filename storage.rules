rules_version = '2';

// Cloud Storage security rules for HPH Renewable.
// Paste into: Firebase console → Storage → Rules → Publish.

service firebase.storage {
  match /b/{bucket}/o {

    // Files attached to "Schedule a Visit" requests (HPH RENEWABLE/schedule-a-visit/).
    // Anyone may upload a new image or PDF of up to 10 MB into a request's
    // folder (staff too, when adding a bill for a client); only admins and the
    // encoder account can download them or delete them (HPH RENEWABLE/admin/:
    // removing an attachment while editing, or an admin deleting the
    // request); nobody can replace files.
    match /visitRequests/{requestId}/{fileName} {
      allow create: if resource == null
                    && request.resource.size <= 10 * 1024 * 1024
                    && (request.resource.contentType.matches('image/.*')
                        || request.resource.contentType == 'application/pdf');
      allow get, delete: if isAdmin() || isEncoder();
      allow list, update: if false;
    }

    // Photos on installer checklist items (HPH RENEWABLE/admin/, jobChecklists/
    // <checklist id>/). The installer account and admins can add an image of up
    // to 10 MB, view them and remove them; nobody can replace a file.
    match /jobChecklists/{checklistId}/{fileName} {
      allow create: if (isAdmin() || isInstaller())
                    && resource == null
                    && request.resource.size <= 10 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*');
      allow get, delete: if isAdmin() || isInstaller();
      allow list, update: if false;
    }

    // Photos of inventory items (HPH RENEWABLE/admin/, Inventory tab;
    // inventory/<item id>/). The installer account and admins can add an image
    // of up to 10 MB, view them and remove them; nobody can replace a file.
    match /inventory/{itemId}/{fileName} {
      allow create: if (isAdmin() || isInstaller())
                    && resource == null
                    && request.resource.size <= 10 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*');
      allow get, delete: if isAdmin() || isInstaller();
      allow list, update: if false;
    }

    // The installer account (adds and views checklist photos). Keep in step
    // with INSTALLER_EMAILS in HPH RENEWABLE/admin/admin.js and isInstaller()
    // in /firestore.rules.
    function isInstaller() {
      return request.auth != null
        && request.auth.token.email in ['hphrenewable@gmail.com'];
    }

    // The encoder account (sees visit request attachments, can add or remove
    // them while editing). Keep in step with ENCODER_EMAILS in
    // HPH RENEWABLE/admin/admin.js and isEncoder() in /firestore.rules.
    function isEncoder() {
      return request.auth != null
        && request.auth.token.email in ['inquiries@hphtechsolutions.com'];
    }

    // Keep in step with ADMIN_EMAILS in HPH RENEWABLE/admin/admin.js and
    // isAdmin() in /firestore.rules.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in ['harold.t.hermosa@gmail.com',
                                     'jeff.hermosa@hphtechsolutions.com',
                                     'lerin.hermosa@hphtechsolutions.com'];
    }
  }
}
